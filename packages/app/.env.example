# Server
PORT=3070
CARDBOARD_DATA_DIR=./data
CARDBOARD_PUBLIC_URL=http://localhost:5173

# Auth: "dev" signs every request in as the seeded admin. "clerk" verifies Clerk session tokens.
CARDBOARD_AUTH=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Email (Resend). Leave empty to log emails to stdout instead of sending.
RESEND_API_KEY=
CARDBOARD_EMAIL_FROM="Milo <milo@example.com>"

# Daily SQLite snapshot (docs/runbooks/backups.md). A negative hour turns it off.
CARDBOARD_BACKUP_HOUR=4
CARDBOARD_BACKUP_KEEP=14

# Runner service. Leave empty to run sessions in "noop" mode (records only).
CARDBOARD_RUNNER_URL=
CARDBOARD_RUNNER_TOKEN=

# Runner-hosted previews. The secret signs the cookie the preview router checks; the domain and
# pattern make a card's hostname. Empty domain means it is taken from CARDBOARD_PUBLIC_URL.
CARDBOARD_PREVIEW_SECRET=
CARDBOARD_PREVIEW_DOMAIN=
CARDBOARD_PREVIEW_HOST_PATTERN={card}.preview.{domain}

# Client (Vite reads VITE_* at build time)
VITE_CLERK_PUBLISHABLE_KEY=
