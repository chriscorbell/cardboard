# Server
PORT=3070
CARDBOARD_DATA_DIR=./data
CARDBOARD_PUBLIC_URL=http://localhost:5173

# Auth: "dev" signs every request in as the seeded admin. "clerk" verifies Clerk session tokens.
CARDBOARD_AUTH=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Email (Resend). Leave empty to log emails to stdout instead of sending.
RESEND_API_KEY=
CARDBOARD_EMAIL_FROM="Milo <milo@cardboard.xode.cc>"

# Runner service. Leave empty to run sessions in "noop" mode (records only).
CARDBOARD_RUNNER_URL=
CARDBOARD_RUNNER_TOKEN=

# Client (Vite reads VITE_* at build time)
VITE_CLERK_PUBLISHABLE_KEY=
